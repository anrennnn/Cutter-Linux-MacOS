# Maintainer: Cutter-Linux <cutter-linux@users.noreply.github.com>
#
# Cutter para Arch Linux, CachyOS, EndeavourOS y Manjaro.
#   makepkg -si

pkgname=cutter-linux
pkgver=0.3.0
pkgrel=1
_commit=bcbd77ed1098099c401a20b89499b27e5ba6974b
pkgdesc="Herramienta Recortes (Super+Shift+S) e historial del portapapeles (Super+V) al estilo Windows"
arch=('any')
url="https://github.com/anrennnn/Cutter-Linux"
license=('MIT')
depends=(
    'python'
    'python-pyqt6'
    'qt6-base'
    'qt6-svg'
    'libnotify'
    'xdg-utils'
    'xdg-user-dirs'
    'hicolor-icon-theme'
)
makedepends=('make')
optdepends=(
    'qt6-wayland: ventanas nativas en sesiones Wayland (KDE Plasma, Hyprland, Sway)'
    'xdg-desktop-portal: captura de pantalla en Wayland'
    'wl-clipboard: historial del portapapeles en Wayland (KDE Plasma, Hyprland, Sway, niri)'
    'xdotool: pegar automáticamente el elemento elegido con Super+V (X11)'
    'xorg-xprop: modo «Recorte de ventana» (X11)'
    'xorg-xwininfo: modo «Recorte de ventana» (X11)'
    'grim: captura en Hyprland y Sway si el portal no responde'
    'gnome-shell-extension-appindicator: icono junto al reloj en GNOME'
)
install=cutter-linux.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('fbbe349ef26abfeefa2dbb31fcfac585e9582ba282f3f04d7f3a1f773b53570d')

package() {
    cd "Cutter-Linux-$_commit"
    make install DESTDIR="$pkgdir" PREFIX=/usr \
        DOCDIR=/usr/share/licenses/$pkgname LICENSE_NAME=LICENSE
}
